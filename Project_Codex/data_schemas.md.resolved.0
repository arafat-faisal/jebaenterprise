## Entity Relationship Diagram

```mermaid
erDiagram
    Product ||--o{ ProductImage : has
    Product ||--o{ ProductVariant : has
    Product ||--o{ ProductVariation : has
    Product }o--|| Category : belongs_to
    Product }o--o{ Tag : has_many
    
    Sale ||--|{ SaleItem : contains
    SaleItem }o--|| Product : references
    SaleItem }o--o| ProductVariation : references
    Sale }o--o| User : placed_by
    
    User ||--|| UserProfile : has
    User ||--o{ Review : writes
    User ||--o{ Wishlist : has
    
    Review }o--|| Product : reviews
    Wishlist }o--|| Product : wishes
    
    Campaign ||--|{ CampaignVariant : has
    CampaignVariant ||--|{ LandingSection : contains
    Campaign }o--o| Product : promotes
    
    VisitorSession }o--|| Campaign : visits
    VisitorSession }o--o| CampaignVariant : shown
    VisitorSession ||--|{ ConversionEvent : triggers
    
    Conversation ||--|{ Message : contains
    Message ||--o{ AISuggestion : generates
    
    BlogPost }o--o{ Product : links_to
    CompetitorPrice }o--|| Product : tracks
    
    AIPage }o--o| Product : generates_for
    AIPage ||--|{ PageConversation : has
    AIPage ||--|{ PageVersion : versions
    
    ProductEvent }o--|| Product : tracks
    SearchEvent }o--o| User : by
```
